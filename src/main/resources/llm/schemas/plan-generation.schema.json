{
  "type": "object",
  "description": "저장한 장소들을 여행 일수에 맞게 일차별로 나눠 배치한 결과",
  "additionalProperties": false,
  "required": ["days", "excluded"],
  "properties": {
    "days": {
      "type": "array",
      "description": "일차별 배치. 1일차부터 마지막 날까지 빠짐없이 넣는다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayNumber", "placeNumbers"],
        "properties": {
          "dayNumber": {
            "type": "integer",
            "description": "며칠째인지. 1부터 시작"
          },
          "placeNumbers": {
            "type": "array",
            "description": "그날 방문할 장소 번호를 방문 순서대로. 장소가 없는 날은 빈 배열",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "이번 일정에 넣지 못한 장소 번호",
      "items": {
        "type": "integer"
      }
    }
  }
}
